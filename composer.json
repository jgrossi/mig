{
    "name": "jgrossi/mig",
    "description": "Simple PHP database migration runner using PDO",
    "license": "MIT",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Mig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mig\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/mig"]
}
