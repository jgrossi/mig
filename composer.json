{
    "name": "jgrossi/mig",
    "description": "Simple PHP database migration runner using PDO",
    "license": "MIT",
    "version": "0.3.0",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Mig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mig\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/mig"],
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "test": "phpunit",
        "check": [
            "@cs-fix",
            "@test"
        ]
    }
}
