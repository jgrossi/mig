#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

use Mig\Command\Create;
use Mig\Command\Down;
use Mig\Command\Refresh;
use Mig\Command\Status;
use Mig\Command\Squash;
use Mig\Command\Up;
use Mig\MigrationFiles;
use Mig\MigrationStore;

// --- load config ---

$configFile = getcwd() . '/mig.php';

if (!file_exists($configFile)) {
    fwrite(STDERR, "Error: mig.php not found in " . getcwd() . "\n\n");
    fwrite(STDERR, "Create a mig.php file in your project root:\n\n");
    fwrite(STDERR, "<?php\nreturn [\n");
    fwrite(STDERR, "    'driver'   => 'mysql',\n");
    fwrite(STDERR, "    'host'     => 'localhost',\n");
    fwrite(STDERR, "    'dbname'   => 'myapp',\n");
    fwrite(STDERR, "    'username' => 'root',\n");
    fwrite(STDERR, "    'password' => 'secret',\n");
    fwrite(STDERR, "    'path'     => __DIR__ . '/db/migrations',\n");
    fwrite(STDERR, "];\n");
    exit(1);
}

$config  = require $configFile;
$command = $argv[1] ?? null;
$path    = $config['path'] ?? getcwd() . '/db/migrations';
$files   = new MigrationFiles($path);

// --- parse options ---

$steps = 1;
foreach (array_slice($argv, 2) as $arg) {
    if (preg_match('/^--steps?=(\d+)$/', $arg, $m)) {
        $steps = (int) $m[1];
        break;
    }
}

$usage = function () use ($argv): void {
    $bin = basename($argv[0]);
    fwrite(STDERR, "Usage: $bin <command>\n\n");
    fwrite(STDERR, "Commands:\n");
    fwrite(STDERR, "  create              Create a new migration file\n");
    fwrite(STDERR, "  up                  Apply all pending migrations\n");
    fwrite(STDERR, "  down [--steps=N]    Roll back the last N applied migrations (default: 1)\n");
    fwrite(STDERR, "  refresh             Roll back all migrations and re-run them\n");
    fwrite(STDERR, "  status              Show applied and pending migrations\n");
    fwrite(STDERR, "  squash              Collapse all applied migrations into one file\n");
    exit(1);
};

// --- create (no DB needed) ---

if ($command === 'create') {
    (new Create($files))->run();
    exit(0);
}

if (!in_array($command, ['up', 'down', 'refresh', 'status', 'squash'], true)) {
    $usage();
}

// --- build DSN ---

if (!empty($config['dsn'])) {
    $dsn = $config['dsn'];
} else {
    $driver = $config['driver'] ?? null;
    if (!$driver) {
        fwrite(STDERR, "Error: mig.php must define 'dsn' or 'driver'\n");
        exit(1);
    }
    $dbname = $config['dbname'] ?? '';
    $host   = $config['host'] ?? 'localhost';
    $port   = $config['port'] ?? null;

    $dsn = match (strtolower($driver)) {
        'mysql'  => 'mysql:host=' . $host
                    . ($port ? ';port=' . $port : '')
                    . ';dbname=' . $dbname
                    . ';charset=utf8mb4',
        'pgsql'  => 'pgsql:host=' . $host
                    . ($port ? ';port=' . $port : '')
                    . ';dbname=' . $dbname,
        'sqlite' => 'sqlite:' . $dbname,
        default  => null,
    };

    if ($dsn === null) {
        fwrite(STDERR, "Error: unsupported driver '$driver'. Use mysql, pgsql, or sqlite.\n");
        exit(1);
    }
}

$username = $config['username'] ?? null;
$password = $config['password'] ?? null;
$table    = $config['table'] ?? 'migrations';

// --- connect ---

try {
    $pdo = new PDO($dsn, $username, $password);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
} catch (PDOException $e) {
    fwrite(STDERR, 'Connection failed: ' . $e->getMessage() . "\n");
    exit(1);
}

// --- dispatch command ---

$store    = new MigrationStore($pdo, $table);
$commands = [
    'up'      => fn () => new Up($pdo, $store, $files),
    'down'    => fn () => new Down($pdo, $store, $files, $steps),
    'refresh' => fn () => new Refresh(new Down($pdo, $store, $files), new Up($pdo, $store, $files)),
    'status'  => fn () => new Status($store, $files),
    'squash'  => fn () => new Squash($store, $files),
];

try {
    $commands[$command]()->run();
} catch (RuntimeException $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}
